digraph G { rankdir=TB; node [shape=box,style="rounded,filled",fillcolor="#E5F2FC",fontname="DejaVu Sans",fontsize=12]; watch [label="watch / inject\nlog.txt"]; fault [label="inject FAULT\nlog_fault.txt"]; test [label="inject TEST\nlog_test.txt"]; file [label="file in\nUTF-8 string"]; fn [label="function\nразбор + диапазоны\nT=5 с"]; sql [label="file\ndb/load.sql"]; exec [label="exec\nsqlite3 -bail"]; debug [label="debug\nstdout / stderr / code"]; {rank=same;watch;fault;test;} {rank=same;file;fn;} {rank=same;sql;exec;debug;} watch -> file; fault -> file; test -> file; file -> fn; fn -> sql [label="выход 2"]; sql -> exec -> debug; fn -> debug [label="выход 1: ошибка"]; }