digraph G { rankdir=TB; node [shape=box,style="rounded,filled",fillcolor="#E5F2FC",fontname="DejaVu Sans",fontsize=12]; edge [fontname="DejaVu Sans",fontsize=10]; init [label="Начало: Serial, входы/выходы\nреле OFF, LED OFF, alarm=false"]; read [label="n=n+1; чтение s1, s2, s3\ns1=100·(ADC−210)/(1023−210), 0…100; s2=ADC×5/1023"]; data [label="Печать DATA n s1 s2 s3"]; test [shape=diamond,label="s1 > 20?"]; active [shape=diamond,label="alarm=false?"]; clear [shape=diamond,label="alarm=true?"]; on [label="alarm=true; реле ON; LED ON\nEVENT THRESHOLD"]; off [label="alarm=false; реле OFF; LED OFF\nEVENT NORMAL"]; wait [label="Задержка 5000 мс"]; init -> read -> data -> test; test -> active [label="да"]; test -> clear [label="нет"]; active -> on [label="да"]; active -> wait [label="нет"]; clear -> off [label="да"]; clear -> wait [label="нет"]; on -> wait; off -> wait; wait -> read; }